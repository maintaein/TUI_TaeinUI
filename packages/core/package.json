{
  "name": "@taein-ui/core",
  "version": "0.3.0",
  "description": "A React UI component library where every component has its own motion — GSAP-driven, zero-runtime CSS, tree-shakable, RSC-ready, WCAG 2.2 AA.",
  "keywords": [
    "component-library",
    "react",
    "typescript",
    "vanilla-extract",
    "components",
    "ui",
    "motion",
    "animation",
    "gsap",
    "accessible"
  ],
  "author": "Taein <daumdaum005@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maintaein/TUI_TaeinUI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/maintaein/TUI_TaeinUI#readme",
  "bugs": {
    "url": "https://github.com/maintaein/TUI_TaeinUI/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/core.css"
  },
  "sideEffects": [
    "./dist/core.css"
  ],
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.14.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^2.0.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^4.0.5",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.8"
  }
}
